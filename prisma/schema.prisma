generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  pickup    String
  dropoff   String
  date      String
  time      String
  distance  Float
  fare      Float
  status    String   @default("pending")
  source    String   @default("website")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("operator")
  createdAt DateTime @default(now())
}
