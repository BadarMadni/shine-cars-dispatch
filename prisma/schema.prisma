generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id            String    @id @default(cuid())
  name          String
  phone         String
  pickup        String
  dropoff       String
  date          String
  time          String
  distance      Float
  fare          Float
  vehicle       String    @default("car")
  status        String    @default("pending")
  source        String    @default("website")
  paymentMethod String    @default("cash")
  paymentStatus String    @default("unpaid")
  driverId      String?
  customerId    String?
  assignedAt    DateTime?
  fareType      String    @default("fixed")
  meterDistance Float?
  meterFare     Float?
  cashCollected Float?
  stops         String?
  notes         String?
  isRecurring   Boolean   @default(false)
  recurringId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  driver        Driver?   @relation(fields: [driverId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  recurring     RecurringBooking? @relation(fields: [recurringId], references: [id])
  invoiceItems  InvoiceItem[]

  @@index([status])
  @@index([createdAt])
  @@index([driverId])
  @@index([customerId])
  @@index([recurringId])
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("operator")
  createdAt DateTime @default(now())
}

model Driver {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  phone             String
  password          String
  status            String    @default("pending")
  isAvailable       Boolean   @default(false)
  isEnabled         Boolean   @default(true)
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  pushToken         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  documents         DriverDocument[]
  bookings          Booking[]
  recurringBookings RecurringBooking[]
  notifications     DriverNotification[]
  chatMessages      ChatMessage[]
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  password    String
  accountType String    @default("individual")
  companyName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  recurringBookings RecurringBooking[]
  invoices    Invoice[]

  @@index([accountType])
}

model RecurringBooking {
  id         String   @id @default(cuid())
  customerId String
  driverId   String?
  pickup     String
  dropoff    String
  stops      String?
  time       String
  vehicle    String   @default("car")
  fare       Float
  distance   Float
  days       String
  name       String
  phone      String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  driver     Driver?  @relation(fields: [driverId], references: [id])
  bookings   Booking[]

  @@index([customerId])
  @@index([driverId])
  @@index([isActive])
}

model Invoice {
  id         String   @id @default(cuid())
  customerId String
  weekStart  String
  weekEnd    String
  total      Float    @default(0)
  status     String   @default("unpaid")
  stripeId   String?
  paidAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  items      InvoiceItem[]

  @@unique([customerId, weekStart])
  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  bookingId String
  fare      Float
  date      String
  pickup    String
  dropoff   String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([invoiceId])
  @@index([bookingId])
}

model DriverNotification {
  id        String   @id @default(cuid())
  driverId  String
  title     String
  body      String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, isRead])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  driverId  String
  message   String
  sender    String   // "driver" or "dispatcher"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, createdAt])
  @@index([driverId, isRead])
}

model DriverDocument {
  id         String   @id @default(cuid())
  driverId   String
  type       String
  fileUrl    String
  expiryDate String
  createdAt  DateTime @default(now())
  driver     Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId])
}
